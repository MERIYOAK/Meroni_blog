<%- include('partials/header.ejs') %>
    <h1>Post Deleter</h1>
    <form action="/deleteMyPost/<%= post.id %>/<%= post.tableName %>?_method=DELETE" method="POST">
        <input type="hidden" name="_method" value="DELETE">
        
        <label for="author">Author/Title:</label>
            <input type="text" name="author" id="author" required value="<%= post.author %>"> 
    
            <label for="quote">Quote/Line:</label>
            <textarea name="quote" id="quote" rows="4" required><%= post.quote %></textarea>
    
            <button type="submit">Delete Post</button>
    </form>
<%- include('partials/footer.ejs') %>