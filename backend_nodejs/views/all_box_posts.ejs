<%- include("partials/header.ejs") %>
    <h1>All Box Posts</h1>
        <% for (let i = 0; i < posts.length; i++) { %>
            <div class="all_box_posts_container">
                <h2><strong>Title: </strong><%= posts[i].title %></h2>
                <p><strong>Link: </strong> <%= posts[i].link %></p>
                <p><strong>Image: </strong> <%= posts[i].image %></p>
                <p><strong>Author Name: </strong> <%= posts[i].author_name %></p>
                <p><strong>AuthorURL: </strong> <%= posts[i].authorURL%></p>
                <p><strong>Id number: </strong> <%= posts[i].id %></p>
            </div>
        <% } %>
<%- include("partials/footer.ejs") %>
