<%- include('partials/footer.ejs') %>
    <h1>Body Post Deleter</h1>
    <form action="/deleteMyPost/<%= post.id %>/<%= post.tableName %>?_method=DELETE" method="POST">
        <input type="hidden" name="_method" value="DELETE">

        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required value="<%= post.title %>"><br>

        <label for="line">Line:</label>
        <textarea name="line" id="line" required><%= post.line %></textarea><br>

        <label for="link">Link:</label>
        <input type="text" name="link" id="link" required value="<%= post.link %>"><br>

        <label for="icon">Icon:</label>
        <input type="text" name="brands[icon]" id="icon" required value="<%= post.brands.icon %>"><br>

        <label for="iconURL">IconURL:</label>
        <input type="text" name="brands[link]" id="iconURL" required value="<%= post.brands.link %>"><br>

        <label for="image1">Image1 URL:</label>
        <input type="text" name="image1" id="image1" required value="<%= post.image1 %>"><br>

        <label for="image2">Image2 URL:</label>
        <input type="text" name="image2" id="image2" required value="<%= post.image2 %>"><br>

        <label for="image3">Image3 URL:</label>
        <input type="text" name="image3" id="image3" required value="<%= post.image3 %>"><br>

        <button type="submit">Delete Body Post</button>
    </form>
<%- include('partials/footer.ejs') %>