<%- include("partials/header.ejs") %>
    <h1>All Body Posts</h1>
        <% for (let i = 0; i < posts.length; i++) { %>
            <div class="all_body_post2_container">
                <h2><strong>Title: </strong><%= posts[i].title %></h2>
                <p><strong>Type: </strong> <%= posts[i].type %></p>
                <p><strong>Image URL</strong>: <%= posts[i].image %></p>
                <p><strong>Link: </strong> <%= posts[i].link %></p>
                <p><strong>Content: </strong> <%= posts[i].content %></p>
                <p><strong>Date: </strong> <%= posts[i].date %></p>
                <p><strong>Writer: </strong> <%= posts[i].writer %></p>
                <p><strong>Id number: </strong> <%= posts[i].id %></p>
            </div>
        <% } %>
<%- include("partials/footer.ejs") %>
