<%- include('partials/header.ejs') %>
    <h1>Slide Deleter</h1>
    <form action="/deleteMyPost/<%= post.id %>/<%= post.tableName %>?_method=DELETE" method="POST">
        <input type="hidden" name="_method" value="DELETE">
        
        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required value="<%= post.title %>"><br>

        <label for="image">Image:</label>
        <input type="text" name="image" id="image" required value="<%= post.image %>"><br>

        <label for="URL">URL:</label>
        <input type="text" name="URL" id="URL" required value="<%= post.URL %>"><br>

        <button type="submit">Delete Slide</button>
    </form>
<%- include('partials/footer.ejs') %>