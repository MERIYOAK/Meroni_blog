<%- include("partials/header.ejs") %>
    <h1>All Small Posts</h1>
        <% for (let i = 0; i < posts.length; i++) { %>
            <div class="all_small_posts_container">
                <h2><strong>Author/Title: </strong><%= posts[i].author %></h2>
                <p><strong>Quote/Line: </strong> <%= posts[i].quote %></p>
                <p><strong>Id number: </strong> <%= posts[i].id %></p>
            </div>
        <% } %>
<%- include("partials/footer.ejs") %>
