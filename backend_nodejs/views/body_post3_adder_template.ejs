<%- include('partials/header.ejs') %>
    <h1>Add a Body Post</h1>
    <form action="/addPost" method="POST">

        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required><br>

        <label for="line">Line:</label>
        <textarea name="line" id="line" required></textarea><br>

        <label for="link">Link:</label>
        <input type="text" name="link" id="link" required><br>

        <label for="icon">Icon:</label>
        <input type="text" name="brands[icon]" id="icon" required><br>

        <label for="iconURL">IconURL:</label>
        <input type="text" name="brands[link]" id="iconURL" required><br>

        <label for="image1">Image1 URL:</label>
        <input type="text" name="image1" id="image1" required><br>

        <label for="image2">Image2 URL:</label>
        <input type="text" name="image2" id="image2" required><br>

        <label for="image3">Image3 URL:</label>
        <input type="text" name="image3" id="image3" required><br>

        <select id="postType" name="postType" class="postType">
            <option value="" disabled selected>Select Post Type</option>
            <option value="politics_body_post">Politics Body Post</option>
        </select>

        <button type="submit">Add Body Post</button>
    </form>
<%- include('partials/footer.ejs') %>