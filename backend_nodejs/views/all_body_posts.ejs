<%- include("partials/header.ejs") %>
    <h1>All Body Posts</h1>
        <% for (let i = 0; i < posts.length; i++) { %>
            <div class="all_body_posts_container">
                <h2><strong>Main Title: </strong><%= posts[i].main_title %></h2>
                <p><strong>Sub Title: </strong><%= posts[i].sub_title %></p>
                <p><strong>Main Link: </strong><%= posts[i].main_link %></p>
                <p><strong>Image URL</strong>: <%= posts[i].image %></p>
                <p><strong>Article Title: </strong> <%= posts[i].article_title %></p>
                <p><strong>Article Content: </strong> <%= posts[i].article_content %></p>
                <p><strong>Article Link: </strong> <%= posts[i].article_link %></p>
                <p><strong>Author: </strong> <%= posts[i].author_name %></p>
                <p><strong>AuthorURL: </strong> <%= posts[i].authorURL %></p>
                <p><strong>Date: </strong> <%= posts[i].date %></p>
                <p><strong>Id number: </strong> <%= posts[i].id %></p>
            </div>
        <% } %>
<%- include("partials/footer.ejs") %>