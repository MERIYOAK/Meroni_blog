<%- include('partials/header.ejs') %>
    <h1>Add a Box Post</h1>
    <form action="/postAdder" method="POST">
        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required><br>

        <label for="link">Link:</label>
        <input type="text" name="link" id="link" required><br>

        <label for="image">Image URL:</label>
        <input type="text" name="image" id="image" required><br>

        <label for="author_name">Author Name:</label>
        <input type="text" name="author_name" id="author_name" required><br>

        <label for="authorURL">Author URL:</label>
        <input type="text" name="authorURL" id="authorURL" required><br>

        <select id="postType" name="postType" class="postType">
            <option value="" disabled selected>Select Article Type</option>
            <option value="technology_box_post">Technology Box Post</option>
        </select>

        <button type="submit">Add Box Post</button>
    </form>
<%- include('partials/footer.ejs') %>