<%- include('partials/header.ejs') %>
    <h1>Body Post Deleter</h1>
    <form action="/deleteMyPost/<%= post.id %>/<%= post.tableName %>?_method=DELETE" method="POST">
        <input type="hidden" name="_method" value="DELETE">

        <label for="image">Image URL:</label>
        <input type="text" name="image" id="image" required value="<%= post.image %>"><br>

        <label for="type">Type:</label>
        <input type="text" name="type" id="type" required value="<%= post.type %>"><br>

        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required value="<%= post.title %>"><br>

        <label for="content">Content:</label>
        <textarea name="content" id="content" required><%= post.content %></textarea><br>

        <label for="link">Link:</label>
        <input type="text" name="link" id="link" required value="<%= post.link %>"><br>

        <label for="date">Date:</label>
        <input type="date" name="date" id="date" required value="<%= post.date %>"><br>

        <label for="writer">Writer:</label>
        <input type="text" name="writer" id="writer" required value="<%= post.writer %>"><br>

        <button type="submit">Delete Body Post</button>
    </form>
<%- include('partials/footer.ejs') %>