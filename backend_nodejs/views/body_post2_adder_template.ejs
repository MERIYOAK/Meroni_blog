<%- include('partials/header.ejs') %>
    <h1>Add a Body Post</h1>
    <form action="/addPost" method="POST">

        <label for="image">Image URL:</label>
        <input type="text" name="image" id="image" required><br>

        <label for="type">Type:</label>
        <input type="text" name="type" id="type" required><br>

        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required><br>

        <label for="content">Content:</label>
        <textarea name="content" id="content" required></textarea><br>

        <label for="link">Link:</label>
        <input type="text" name="link" id="link" required><br>

        <label for="date">Date:</label>
        <input type="date" name="date" id="date" required><br>

        <label for="writer">Writer:</label>
        <input type="text" name="writer" id="writer" required><br>

        <select id="postType" name="postType" class="postType">
            <option value="" disabled selected>Select Article Type</option>
            <option value="art_body_post">Art Body Post</option>
        </select>

        <button type="submit">Add Body Post</button>
    </form>
<%- include('partials/footer.ejs') %>