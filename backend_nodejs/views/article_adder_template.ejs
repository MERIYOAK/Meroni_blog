<%- include('partials/header.ejs') %>
    <h1>Add an Article</h1>
    <form action="/addPost" method="POST">
        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required><br>

        <label for="date">Date:</label>
        <input type="date" name="date" id="date" required><br>

        <label for="content">Content:</label>
        <textarea name="content" id="content" required></textarea><br>

        <label for="image">Image URL:</label>
        <input type="text" name="image" id="image" required><br>

        <label for="goToURL">Go to URL:</label>
        <input type="text" name="goToURL" id="goToURL" required><br>

        <select id="postType" name="postType" class="postType">
            <option value="" disabled selected>Select Article Type</option>
            <option value="philosophy_article_post">Philosophy Article Post</option>
            <option value="science_article_post">Science Article Post</option>
        </select>

        <button type="submit">Add Article</button>
    </form>
<%- include('partials/footer.ejs') %>