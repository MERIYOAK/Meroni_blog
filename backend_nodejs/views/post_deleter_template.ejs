<%- include('partials/header.ejs') %>
    <h1>Post Deleter</h1>
    <form action="/deleteMyPost/<%= post.id %>/<%= post.tableName %>?_method=DELETE" method="POST">
        <input type="hidden" name="_method" value="DELETE">

        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required value="<%= post.title %>"><br>

        <label for="intro">Intro:</label>
        <textarea name="content[intro]" id="intro" required><%= post.content.intro %></textarea><br>

        <label for="body">Body:</label>
        <textarea name="content[body]" id="body" required><%= post.content.body %></textarea><br>

        <label for="conclude">Conclusion:</label>
        <textarea name="content[conclude]" id="conclude" required><%= post.content.conclude %></textarea><br>

        <label for="image">Image URL:</label>
        <input type="text" name="image" id="image" required value="<%= post.image %>"><br>

        <label for="date">Date:</label>
        <input type="date" name="date" id="date" required value="<%= post.date %>"><br>

        <label for="authorURL">Author URL:</label>
        <input type="text" name="authorURL" id="authorURL" required value="<%= post.authorURL %>"><br>

        <button type="submit">Delete Post</button>
    </form>
<%- include('partials/footer.ejs') %>