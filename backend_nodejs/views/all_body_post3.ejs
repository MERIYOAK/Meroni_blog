<%- include("partials/header.ejs") %>
    <h1>All Body Posts</h1>
        <% for (let i = 0; i < posts.length; i++) { %>
            <div class="all_body_post3_container">
                <h2><strong>Title: </strong><%= posts[i].title %></h2>
                <p><strong>Line: </strong> <%= posts[i].line %></p>
                <p><strong>Link: </strong> <%= posts[i].link %></p>
                <p><strong>Icon</strong>: <%= posts[i].brands.icon %></p>
                <p><strong>BrandURL: </strong> <%= posts[i].brands.link %></p>
                <p><strong>Image1: </strong> <%= posts[i].image1 %></p>
                <p><strong>Image2: </strong> <%= posts[i].image2 %></p>
                <p><strong>Image3: </strong> <%= posts[i].image3 %></p>
                <p><strong>Id number: </strong> <%= posts[i].id %></p>
            </div>
        <% } %>
<%- include("partials/footer.ejs") %>
