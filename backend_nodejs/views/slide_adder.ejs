<%- include('partials/header.ejs') %>
    <h1>Add a Slide</h1>
    <form action="/postAdder" method="POST">
        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required>

        <label for="image">Image:</label>
        <input type="text" name="image" id="image" required><br>

        <label for="URL">URL:</label>
        <input type="text" name="URL" id="URL" required><br>

        <select id="postType" name="postType" class="postType">
            <option value="" disabled selected>Select Post Type</option>
            <option value="finance_slide_post">Slide Post</option>
        </select>

        <button type="submit">Add Slide</button>
    </form>
<%- include('partials/footer.ejs') %>